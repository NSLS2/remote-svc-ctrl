    </widget>
    <widget typeId="org.csstudio.opibuilder.widgets.TextUpdate" version="1.0.0">
      <name>UnitFile</name>
      <pv_name>$(PREFIX)UnitFile</pv_name>
      <x>92</x>
      <y>72</y>
      <width>360</width>
      <height>25</height>
      <format_type>4</format_type>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <background_color>
        <color red="204" green="204" blue="204" />
      </background_color>
    </widget>

    <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
      <name>Load State Label</name>
      <x>0</x>
      <y>102</y>
      <width>120</width>
      <height>25</height>
      <text>Load State</text>
      <transparent>true</transparent>
      <auto_size>false</auto_size>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget typeId="org.csstudio.opibuilder.widgets.TextUpdate" version="1.0.0">
      <name>LoadState</name>
      <pv_name>$(PREFIX)LoadState</pv_name>
      <x>92</x>
      <y>102</y>
      <width>360</width>
      <height>25</height>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <background_color>
        <color red="204" green="204" blue="204" />
      </background_color>
      <rules>
        <rule name="TextColor" prop_id="foreground_color" output_expression="false">
          <exp bool_exp="pv0==0">
            <value>
              <color red="0" green="128" blue="0" />
            </value>
          </exp>
          <exp bool_exp="pv0!=0">
            <value>
              <color red="255" green="0" blue="0" />
            </value>
          </exp>
          <pv trig="true">$(PREFIX)LoadState</pv>
        </rule>
      </rules>
    </widget>

    <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
      <name>Enabled Label</name>
      <x>0</x>
      <y>132</y>
      <width>120</width>
      <height>25</height>
      <text>Enabled</text>
      <transparent>true</transparent>
      <auto_size>false</auto_size>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget typeId="org.csstudio.opibuilder.widgets.TextUpdate" version="1.0.0">
      <name>Enabled</name>
      <pv_name>$(PREFIX)Enabled</pv_name>
      <x>92</x>
      <y>132</y>
      <width>360</width>
      <height>25</height>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <background_color>
        <color red="204" green="204" blue="204" />
      </background_color>
      <rules>
        <rule name="TextColor" prop_id="foreground_color" output_expression="false">
          <exp bool_exp="pv0==0">
            <value>
              <color red="0" green="128" blue="0" />
            </value>
          </exp>
          <exp bool_exp="pv0==1">
            <value>
              <color red="204" green="51" blue="51" />
            </value>
          </exp>
          <pv trig="true">$(PREFIX)Enabled</pv>
        </rule>
      </rules>
    </widget>

    <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
      <name>Active State Label</name>
      <x>0</x>
      <y>162</y>
      <width>120</width>
      <height>25</height>
      <text>Active State</text>
      <transparent>true</transparent>
      <auto_size>false</auto_size>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget typeId="org.csstudio.opibuilder.widgets.TextUpdate" version="1.0.0">
      <name>ActiveState</name>
      <pv_name>$(PREFIX)ActiveState</pv_name>
      <x>92</x>
      <y>162</y>
      <width>360</width>
      <height>25</height>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <background_color>
        <color red="204" green="204" blue="204" />
      </background_color>
      <rules>
        <rule name="TextColor" prop_id="foreground_color" output_expression="false">
          <exp bool_exp="pv0==0">
            <value>
              <color red="0" green="128" blue="0" />
            </value>
          </exp>
          <exp bool_exp="pv0==1 || pv0==4">
            <value>
              <color red="255" green="255" blue="0" />
            </value>
          </exp>
          <exp bool_exp="pv0 != 0 &amp;&amp; pv0 != 1 &amp;&amp; pv0 != 4">
            <value>
              <color red="255" green="0" blue="0" />
            </value>
          </exp>
          <pv trig="true">$(PREFIX)ActiveState</pv>
        </rule>
      </rules>
    </widget>

    <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
      <name>Sub State Label</name>
      <x>0</x>
      <y>192</y>
      <width>120</width>
      <height>25</height>
      <text>Sub State</text>
      <transparent>true</transparent>
      <auto_size>false</auto_size>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget typeId="org.csstudio.opibuilder.widgets.TextUpdate" version="1.0.0">
      <name>SubState</name>
      <pv_name>$(PREFIX)SubState</pv_name>
      <x>92</x>
      <y>192</y>
      <width>360</width>
      <height>25</height>
      <format_type>4</format_type>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <background_color>
        <color red="204" green="204" blue="204" />
      </background_color>
      <rules>
        <rule name="TextColor" prop_id="foreground_color" output_expression="false">
          <exp bool_exp="pvSev0==0">
            <value>
              <color red="0" green="128" blue="0" />
            </value>
          </exp>
          <exp bool_exp="pvSev0==2">
            <value>
              <color red="255" green="0" blue="0" />
            </value>
          </exp>
          <pv trig="true">$(PREFIX)SubState</pv>
        </rule>
      </rules>
    </widget>

