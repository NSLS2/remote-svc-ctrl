      </font>
      <actions hook="false" hook_all="false">
        <action type="OPEN_DISPLAY">
          <path>asynRecord.opi</path>
          <macros>
            <include_parent_macros>true</include_parent_macros>
            <P>$(ASYN_IO)</P>
          </macros>
          <mode>0</mode>
          <description>Asyn record</description>
        </action>
      </actions>
    </widget>
  </widget>
</display>
