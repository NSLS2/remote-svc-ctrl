  <!-- Controls group -->
  <widget typeId="org.csstudio.opibuilder.widgets.groupingContainer" version="1.0.0">
    <name>Controls</name>
    <x>5</x>
    <y>560</y>
    <width>495</width>
    <height>80</height>
    <transparent>true</transparent>
    <show_scrollbar>false</show_scrollbar>
    <lock_children>false</lock_children>
    <border_style>13</border_style>
    <border_width>1</border_width>
    <border_color>
      <color red="0" green="149" blue="255" />
    </border_color>
    <foreground_color>
      <color red="0" green="149" blue="255" />
    </foreground_color>

    <widget typeId="org.csstudio.opibuilder.widgets.ActionButton" version="2.0.0">
      <name>Start</name>
      <x>17</x>
      <y>7</y>
      <width>125</width>
      <height>35</height>
      <text>Start</text>
      <push_action_index>0</push_action_index>
      <toggle_button>false</toggle_button>
      <foreground_color>
        <color red="240" green="240" blue="240" />
      </foreground_color>
      <background_color>
        <color red="0" green="128" blue="0" />
      </background_color>
      <font>
        <fontdata fontName="Liberation Sans" height="16" style="1" />
      </font>
      <actions hook="false" hook_all="false">
        <action type="WRITE_PV">
          <pv_name>$(PREFIX)Start</pv_name>
          <value>1</value>
          <timeout>10</timeout>
          <confirm_message></confirm_message>
          <description>Start Service</description>
        </action>
      </actions>
    </widget>

    <widget typeId="org.csstudio.opibuilder.widgets.ActionButton" version="2.0.0">
      <name>Stop</name>
      <x>164</x>
      <y>7</y>
      <width>125</width>
      <height>35</height>
      <text>Stop</text>
      <push_action_index>0</push_action_index>
      <toggle_button>false</toggle_button>
      <foreground_color>
        <color red="255" green="255" blue="255" />
      </foreground_color>
      <background_color>
        <color red="255" green="0" blue="0" />
      </background_color>
      <font>
        <fontdata fontName="Liberation Sans" height="16" style="1" />
      </font>
      <actions hook="false" hook_all="false">
        <action type="WRITE_PV">
          <pv_name>$(PREFIX)Stop</pv_name>
          <value>1</value>
          <timeout>10</timeout>
          <confirm_message>Are you sure you want to stop $(SVC)?</confirm_message>
          <description>Stop Service</description>
        </action>
      </actions>
    </widget>

    <widget typeId="org.csstudio.opibuilder.widgets.ActionButton" version="2.0.0">
      <name>Restart</name>
      <x>314</x>
      <y>7</y>
      <width>125</width>
      <height>35</height>
      <text>Restart</text>
      <push_action_index>0</push_action_index>
      <toggle_button>false</toggle_button>
      <font>
        <fontdata fontName="Liberation Sans" height="16" style="1" />
      </font>
      <actions hook="false" hook_all="false">
        <action type="WRITE_PV">
          <pv_name>$(PREFIX)Restart</pv_name>
          <value>1</value>
          <timeout>10</timeout>
          <confirm_message>Are you sure you want to restart $(SVC)?</confirm_message>
          <description>Restart Service</description>
        </action>
      </actions>
    </widget>
  </widget>

  <!-- Logs group -->
  <widget typeId="org.csstudio.opibuilder.widgets.groupingContainer" version="1.0.0">
    <name>Logs</name>
    <x>500</x>
    <y>35</y>
    <width>690</width>
    <height>525</height>
    <transparent>true</transparent>
    <show_scrollbar>false</show_scrollbar>
    <lock_children>false</lock_children>
    <border_style>13</border_style>
    <border_width>1</border_width>
    <border_color>
      <color red="0" green="149" blue="255" />
    </border_color>
    <foreground_color>
      <color red="0" green="149" blue="255" />
    </foreground_color>

    <widget typeId="org.csstudio.opibuilder.widgets.TextUpdate" version="1.0.0">
      <name>Logs</name>
      <pv_name>$(PREFIX)Logs</pv_name>
      <x>0</x>
      <y>10</y>
      <width>652</width>
      <height>477</height>
      <format_type>4</format_type>
      <transparent>true</transparent>
      <wrap_words>false</wrap_words>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <vertical_alignment>0</vertical_alignment>
    </widget>
  </widget>

  <!-- Command Interface group -->
  <widget typeId="org.csstudio.opibuilder.widgets.groupingContainer" version="1.0.0">
    <name>Command Interface</name>
    <x>500</x>
    <y>560</y>
    <width>690</width>
    <height>80</height>
    <transparent>true</transparent>
    <show_scrollbar>false</show_scrollbar>
    <lock_children>false</lock_children>
    <border_style>13</border_style>
    <border_width>1</border_width>
    <border_color>
      <color red="0" green="149" blue="255" />
    </border_color>
    <foreground_color>
      <color red="0" green="149" blue="255" />
    </foreground_color>

    <widget typeId="org.csstudio.opibuilder.widgets.TextInput" version="2.0.0">
      <name>Text Entry</name>
      <pv_name>$(ASYN_IO).AOUT</pv_name>
      <x>12</x>
      <y>7</y>
      <width>500</width>
      <height>35</height>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <background_color>
        <color red="204" green="204" blue="204" />
      </background_color>
    </widget>

    <widget typeId="org.csstudio.opibuilder.widgets.ActionButton" version="2.0.0">
      <name>AsynIO</name>
      <x>522</x>
      <y>7</y>
      <width>125</width>
      <height>35</height>
      <text>AsynIO</text>
      <push_action_index>0</push_action_index>
      <toggle_button>false</toggle_button>
      <foreground_color>
        <color red="255" green="255" blue="255" />
      </foreground_color>
      <background_color>
