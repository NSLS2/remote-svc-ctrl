<?xml version="1.0" encoding="UTF-8"?>
<display typeId="org.csstudio.opibuilder.Display" version="1.0.0">
  <name>$(SVC) on $(HOST)</name>
  <x>0</x>
  <y>0</y>
  <width>1200</width>
  <height>650</height>
  <background_color>
    <color red="255" green="255" blue="255" />
  </background_color>
  <foreground_color>
    <color red="0" green="0" blue="0" />
  </foreground_color>
  <show_grid>true</show_grid>
  <show_ruler>true</show_ruler>
  <auto_zoom_to_fit_all>false</auto_zoom_to_fit_all>
  <boy_version>5.1.0</boy_version>

  <!-- Title -->
  <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
    <name>Title</name>
    <x>5</x>
    <y>5</y>
    <width>1185</width>
    <height>30</height>
    <text>$(SVC) on $(HOST) - $(PREFIX)</text>
    <transparent>false</transparent>
    <auto_size>false</auto_size>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <foreground_color>
      <color red="255" green="255" blue="255" />
    </foreground_color>
    <background_color>
      <color red="0" green="149" blue="255" />
    </background_color>
    <font>
      <fontdata fontName="Liberation Sans" height="22" style="1" />
    </font>
  </widget>

  <!-- Status group -->
  <widget typeId="org.csstudio.opibuilder.widgets.groupingContainer" version="1.0.0">
    <name>Status</name>
    <x>5</x>
    <y>35</y>
    <width>495</width>
    <height>525</height>
    <transparent>true</transparent>
    <show_scrollbar>false</show_scrollbar>
    <lock_children>false</lock_children>
    <border_style>13</border_style>
    <border_width>1</border_width>
    <border_color>
      <color red="0" green="149" blue="255" />
    </border_color>
    <foreground_color>
      <color red="0" green="149" blue="255" />
    </foreground_color>

    <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
      <name>Unit Label</name>
      <x>0</x>
      <y>12</y>
      <width>120</width>
      <height>25</height>
      <text>Unit</text>
      <transparent>true</transparent>
      <auto_size>false</auto_size>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget typeId="org.csstudio.opibuilder.widgets.TextUpdate" version="1.0.0">
      <name>Unit</name>
      <pv_name>$(PREFIX)Unit</pv_name>
      <x>92</x>
      <y>12</y>
      <width>360</width>
      <height>25</height>
      <format_type>4</format_type>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <background_color>
        <color red="204" green="204" blue="204" />
      </background_color>
    </widget>

    <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
